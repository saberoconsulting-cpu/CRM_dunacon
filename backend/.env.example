# Conexión Postgres gestionado (Supabase/Pooler). Pega tus valores sin exponerlos.
# No uses archivos .env real en el repositorio.
DB_HOST=pooler.supabase.com
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=postgres
DB_SSL=true

# API
PORT=3001
# Opcional: ID del proyecto cuya estructura de flujo se copia a proyectos nuevos.
# Por defecto: Altaduna Prueba CRM (proyecto 5).
CASHFLOW_TEMPLATE_PROJECT_ID=5
JWT_SECRET=cambia_esto_secreto_largo
JWT_EXPIRES_IN=1d
FRONTEND_URL=https://crm.dunacon.pe

# Almacenamiento (no se usa en producción; las imágenes van a Cloudinary)
UPLOAD_DIR=./uploads

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

